# Fastify Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# PostgreSQL Connection (Local or Supabase Free Tier)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pageshooter

# JWT Authentication (Must be replaced with a unique 32+ char secret in production)
JWT_SECRET=super_secret_cryptographic_key_min_32_characters_long
JWT_EXPIRES_IN=24h

# Operational Capacity Ceiling (Empirically verified for 512MB free-tier container)
MAX_ACTIVE_ROOMS=20

# Google OAuth 2.0 (Optional for local dev without live Google OAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

